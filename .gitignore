# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*storybook.log

node_modules
dist
dist-ssr
storybook-static
.env
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local content storage
/content/
/.claude/settings.local.json

# Simple OAuth keys (drupal-cms variant)
/keys/

# Codex CLI home (.ddev/config.codex.yaml points CODEX_HOME here). Only the MCP
# registration is tracked; sessions, logs, history and auth.json are local and
# auth.json holds credentials.
/.codex/*
!/.codex/config.toml

# One Line Installer install-time hook scripts. The installer stages these into
# the project root to run them; the canonical copies live in .drupalaibp/, so
# keep the root duplicates out of the baseline commit.
/reinit-git.sh
/project-rename.sh
/ddev-restart.sh
/setup-canvas-connection.sh
/setup-featherless.sh
/setup-mcp.sh
/mcp-login.sh
/hosted-canvas-setup.sh
/finalize-project.sh

# Installer state marker (written by reinit-git.sh).
/.ddev/.drupalaibp-scaffolded

# Generated by setup-evals.sh (evals config): machine-specific eval service
# compose - absolute paths, uid, docker socket gid. Regenerated on demand.
/.ddev/docker-compose.abp-eval.yaml

# Drupal scaffold (drupal-cms variant). The whole config repo is overlaid onto a
# fresh Drupal scaffold, so this file replaces the scaffold's own .gitignore —
# these entries keep the baseline commit to the component library + project
# config, not Composer-managed Drupal core / contrib / vendor.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/.ht.router.php
/web/.htaccess
/web/autoload.php
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config

# >>> npm-scaffold (managed section, do not edit) >>>
/skills/content-management/SKILL.md
# <<< npm-scaffold <<<
.ddev/.env
# drupal/ai_best_practices: per-developer settings, see its README
/ai_best_practices.yaml

# Eval harness: never in bed history (the SUT reads history via git show).
/.drupalaibp/evals/
/.ddev/docker-compose.abp-eval.yaml

# DevPanel data export (devpanel-deploy skill): database dump and files archive.
/.devpanel-export/
