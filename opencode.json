{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "drupal": {
      "type": "remote",
      "url": "https://devpanelmcp.ddev.site/mcp",
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git * push*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "sftp*": "deny"
    }
  }
}
